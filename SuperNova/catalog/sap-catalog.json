        "INCO2": { "type": "CHAR(28)", "text": "Incoterms (Part 2)" },
        "KNUMV": { "type": "CHAR(10)", "text": "Number of the Document Condition" },
        "KALSM": { "type": "CHAR(6)", "text": "Pricing Procedure" },
        "RESWK": { "type": "CHAR(4)", "text": "Supplying (Issuing) Plant in Stock Transport Order" },
        "FRGKE": { "type": "CHAR(1)", "text": "Release Indicator" }
